# ---------- PostgreSQL ----------
POSTGRES_USER=arce
POSTGRES_PASSWORD=cambiame
POSTGRES_DB=arce_licitaciones
# Puerto publicado en 127.0.0.1 para desarrollo nativo / psql
POSTGRES_PORT=5433

# ---------- App ----------
PORT=3000
TZ=America/Montevideo
LOG_LEVEL=info
# Solo para correr la app nativa (npm run dev / pipeline:once). Dentro de Docker se arma solo.
DATABASE_URL=postgres://arce:cambiame@localhost:5433/arce_licitaciones

# ---------- Pipeline ----------
# Rubro a monitorear: app/rubros/<RUBRO>.json
RUBRO=aluminio
# Cada cuánto corre el pipeline (cron de 5 campos)
CRON=*/15 * * * *
CRON_ENABLED=true
# Corre una vez al arrancar el contenedor
RUN_ON_START=true
MAX_ANALISIS_POR_CORRIDA=50

# ---------- LLM ----------
# ollama | anthropic
LLM_PROVIDER=ollama
# Desde Docker, Ollama del host: http://host.docker.internal:11434 ; nativo: http://localhost:11434 ; perfil compose: http://ollama:11434
OLLAMA_HOST=http://host.docker.internal:11434
OLLAMA_MODEL=qwen3.5:9b
# Contexto del modelo. En CPU, bajar a 8192 si un pliego tarda más de ~3 min.
OLLAMA_NUM_CTX=16384
# Solo si LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
