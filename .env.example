# ---------- PostgreSQL ----------
POSTGRES_USER=arce
POSTGRES_PASSWORD=cambiame
POSTGRES_DB=arce_licitaciones
# Puerto publicado en 127.0.0.1 para desarrollo nativo / psql
POSTGRES_PORT=5433

# ---------- App ----------
PORT=3000
TZ=America/Montevideo
LOG_LEVEL=info
# Solo para correr la app nativa (npm run dev / pipeline:once). Dentro de Docker se arma solo.
DATABASE_URL=postgres://arce:cambiame@localhost:5433/arce_licitaciones

# ---------- Pipeline ----------
# Rubro a monitorear: app/rubros/<RUBRO>.json
RUBRO=aluminio
# Cada cuánto corre el pipeline (cron de 5 campos)
CRON=*/15 * * * *
CRON_ENABLED=true
# Corre una vez al arrancar el contenedor
RUN_ON_START=true
MAX_ANALISIS_POR_CORRIDA=50

# ---------- LLM ----------
# ollama | anthropic
LLM_PROVIDER=ollama
# Ollama visto desde la app corriendo NATIVA (npm run dev / pipeline:once)
OLLAMA_HOST=http://localhost:11434
# Ollama visto desde el CONTENEDOR app: Ollama del host → http://host.docker.internal:11434 ; perfil compose → http://ollama:11434
OLLAMA_HOST_DOCKER=http://host.docker.internal:11434
# qwen3.5:4b (3,3 GB) es el equilibrio medido en CPU; qwen3.5:9b (6,5 GB) analiza mejor pero necesita ~8 GB de RAM libres; llama3.2:3b es rápido pero se equivoca más.
OLLAMA_MODEL=qwen3.5:4b
# Contexto del modelo: 8192 entra en RAM con el 4b; con 16384 entran pliegos de ~40k caracteres sin fragmentar pero usa más memoria.
OLLAMA_NUM_CTX=8192
# Solo si LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
